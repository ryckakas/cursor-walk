# LF in the working tree too: php-cs-fixer requires it, and a CRLF Windows checkout
# would fail `composer cs` locally while CI passes.
* text=auto eol=lf

*.php text eol=lf diff=php
*.md text eol=lf
*.json text eol=lf
*.neon text eol=lf
*.xml text eol=lf
*.yml text eol=lf

# Dev-only files stay out of what `composer require` installs.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/.roave-backward-compatibility-check.xml export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/bonsai-lint.toml export-ignore
/examples export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/tests export-ignore
/tools export-ignore
