{
    // At 99% line coverage the suite once passed with Paginator's loop guard moved above
    // its yield. Mutation testing catches what line coverage cannot.
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: [
            'src',
        ],
    },
    mutators: {
        '@default': true,
    },
    logs: {
        text: 'build/infection/infection.log',
        // Escaped mutants only, so a CI log is readable.
        summary: 'build/infection/summary.log',
        // Surviving mutants show on the PR diff, where the change was made.
        github: true,
    },
    // A fraction under the measured score, because kill counts vary between PHP versions.
    // Most survivors are equivalent mutants; killing them would buy a number, not a guarantee.
    minMsi: 85,
    minCoveredMsi: 85,
    // A hanging mutant counts as survived; the whole suite runs in under a second.
    timeout: 10,
}
